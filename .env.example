# Copy this file to .env and adjust as needed. Loaded automatically by the backend
# (spring-dotenv) and by docker-compose (env_file).

# --- Ollama model connection ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# --- Chat behaviour ---
CHAT_PROVIDER=ollama
CHAT_TEMPERATURE=0.4
# Token ceiling/floor for a single answer. The app fails fast at startup if MAX < MIN.
CHAT_MAX_TOKENS=300
CHAT_MIN_TOKENS=20

# --- Spring profile: dev | test | stage | prod ---
SPRING_PROFILES_ACTIVE=dev

# --- Ports ---
API_PORT=8080
UI_PORT=4200

# --- CORS: the Angular app's origin ---
UI_ORIGIN=http://localhost:4200

# --- JWT auth ---
# DEMO ONLY default below (also baked into application.yml as a fallback). Generate your own
# with `openssl rand -hex 32` for anything beyond local demo use, and never commit a real one.
JWT_SECRET=demo-only-change-me-0123456789abcdef0123456789abcdef
JWT_EXPIRATION_MINUTES=60
